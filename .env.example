# Copy to .env.local and fill in.
# Without the Supabase values, production builds show a "not connected" screen (they never fall back
# to storing data in the browser). `npm run dev` and builds with VITE_DEMO_MODE=1 use the demo backend.

# Supabase project → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: a MapLibre style URL. Defaults to OpenFreeMap (free, no key).
# Example with MapTiler: https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# VITE_MAP_STYLE_URL=

# Demo/preview builds only: run on the in-browser demo backend. Never set this in production.
# VITE_DEMO_MODE=1
