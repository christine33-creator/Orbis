# Copy to .env.local and fill in. Without the Supabase values the app runs in local demo mode.

# Supabase project → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: a MapLibre style URL. Defaults to OpenFreeMap (free, no key).
# Example with MapTiler: https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# VITE_MAP_STYLE_URL=
